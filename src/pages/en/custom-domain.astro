import ProductPage from '../../layouts/ProductPage.astro';
---
<ProductPage locale="en" pageTitle="Custom domain email" eyebrow="CUSTOM DOMAIN · MEMBER FEATURE" titleTop="Your own domain," titleAccent="your own addresses." description="Connect a domain you control and create aliases on a suffix you can keep even if your service provider changes." primary="Connect a domain" secondary="Try a shared alias first" note="DNS verification · Catch-all option · Portable addresses" variant="domain" metrics={[["YOUR DOMAIN", "A few DNS records"], ["CATCH-ALL", "Any prefix"], ["UNLIMITED", "Aliases on the domain"], ["PORTABLE", "You keep ownership"]]} features={[{ no: '01', title: 'Guided DNS verification', description: 'The console lists each required record and its live status.', points: ['Clear record values', 'Propagation status', 'Usable after verification'] }, { no: '02', title: 'Catch every useful prefix', description: 'Catch-all lets a new prefix receive mail before it is added manually.', points: ['Create addresses at the form', 'Trace each recipient', 'Disable specific routes'] }, { no: '03', title: 'Keep the address portable', description: 'The domain stays yours, so migrating does not require changing every login.', points: ['No provider-owned suffix', 'Move by changing DNS', 'Separate project domains'] }]} detailTitle="A few records connect the whole domain" detailText="Add the verification and mail-routing records shown in the console. Live status makes an incorrect or unpropagated value visible instead of mysterious." faq={[["Which DNS records are needed?", "Mainly mail-routing records plus a record proving domain ownership."], ["What is catch-all?", "It accepts any prefix on the connected domain, even before you create that alias in the console."], ["What happens if I migrate?", "Because you own the domain, update its mail records and keep the same public addresses."]]} />
