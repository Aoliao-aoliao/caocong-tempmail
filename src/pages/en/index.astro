---
import Layout from '../../layouts/Layout.astro';
import IdentityCard from '../../components/IdentityCard';
import { createIdentity } from '../../lib/random';
import { site } from '../../config/site';

const heroIdentity = createIdentity('en');

const products = [
  { mark: 'A', code: 'RELAY INBOX', title: 'Mainstream relay inboxes', href: `${site.appOrigin}/tools/real_mail.cgi`, description: 'Generate a receiving address through an available relay account and read messages in NodeMail. Available suffixes and lifetimes appear on the application page.', points: ['Separate receiving addresses', 'Read mail on the website', 'Use the selected lifetime'] },
  { mark: 'B', code: 'DISPOSABLE TEMP MAIL', title: 'Disposable temp mail', href: '/en/temp-mail/', description: 'Open an inbox instantly for a code, confirmation or download. The inbox and its contents disappear when the timer ends.', points: ['No sign-up required', 'New mail appears quickly', 'Website mail cleaned after expiry'] },
  { mark: 'C', code: 'IDENTITY GENERATOR', title: 'Test addresses and identities', href: '/en/identity/', description: 'Generate names, streets, postal codes and phone numbers in coherent local formats for development, demos and placeholders.', points: ['US-format test data', 'US states and Washington, DC', 'Copy the complete set'] },
];
const steps = [['01', 'Issue', 'Create a relay address or a temporary inbox. Add a formatted test identity when the form needs more fields.'], ['02', 'Use', 'Sign up and receive mail as usual. The other side sees only the address assigned to that context.'], ['03', 'Retire', 'Let temp mail expire or disable one alias. Your real inbox and every other address remain unchanged.']];
const ledger = ['IP and browser data are used for sessions and abuse prevention', 'Website messages and attachments are cleaned after mailbox expiry', 'No phone number or legal identity required at sign-up', 'Human verification uses a third-party verification service', 'Mail is processed to receive, display and clean up messages'];
const useCases = [['Sign-ups and trials', 'Try a new service without giving it your primary inbox.'], ['Downloads and newsletters', 'Leave an address that expires after the material arrives.'], ['Development and testing', 'Generate coherent placeholder accounts and form data.'], ['Forums and communities', 'Keep public conversations separate from daily identity.'], ['Spam quarantine', 'Route marketing into a dedicated alias.'], ['Breach containment', 'Disable one exposed address and leave everything else intact.']];
const faqs = [['How is temp mail different from an anonymous alias?', 'Temp mail expires and fits one-off codes. A relay inbox receives through a configured upstream account and uses the chosen lifetime.'], ['What does each feature do?', 'Temp mail receives short-term messages, relay inboxes offer configured mainstream suffixes, and custom domains give you your own suffix.'], ['Are generated names and addresses real?', 'No. They follow common regional formats but are intended only for development, testing and placeholders.'], ['Is anonymous email legal?', 'Protecting contact information is legitimate, but the tool must not be used for fraud, harassment or any unlawful purpose.'], ['Do I need an account?', 'Temp inboxes and identity tools need no account. Sign in to manage mailboxes attached to your account.'], ['Which kind should I choose?', 'Use temp mail for one code. Choose an appropriate mailbox lifetime if you need to receive messages later, and check its expiry.']];
---

<Layout locale="en">
  <section class="home-hero"><div class="shell home-hero-grid">
    <div class="hero-content"><p class="eyebrow">ANONYMOUS EMAIL · TEMP MAIL · TEST IDENTITY</p><h1 class="display-title">Your real identity,<br /><span class="accent">kept to yourself.</span></h1><p class="hero-copy">Meet every sign-up, subscription and verification with an independent alias or disposable inbox, plus coherent placeholder details when a form asks for more.</p><ul class="hero-promises"><li><strong>No sign-up</strong><span>Temp mail opens instantly</span></li><li><strong>Minimal data</strong><span>Session protection and rate limits</span></li><li><strong>Auto-expiry</strong><span>Inbox removed on time</span></li></ul><div class="hero-actions"><a class="btn btn-primary" href={site.appOrigin}>Get an anonymous inbox</a><a class="btn btn-secondary" href="#how">See how it works</a></div></div>
    <div class="hero-card-wrap"><IdentityCard locale="en" initialIdentity={heroIdentity} client:load /><p class="hero-card-note">One context, one identity. Your real name, address and phone stay outside the record.</p></div>
  </div></section>
  <section class="section"><div class="shell"><div class="section-heading" data-reveal><p class="eyebrow">THE TOOLKIT</p><h2>A complete identity isolation kit</h2><p>Three tools, three jobs: relay inboxes, temporary inboxes and US-format test data. Choose by context so one leak cannot expose the rest.</p></div><div class="product-grid">{products.map((product) => <article class="product-card plate" data-reveal><div class="product-card-top"><span class="product-mark">{product.mark}</span><span class="product-code">{product.code}</span></div><h3><a href={product.href}>{product.title}</a></h3><p>{product.description}</p><ul class="product-points">{product.points.map((point) => <li>{point}</li>)}</ul></article>)}</div></div></section>
  <section class="section section-soft" id="how"><div class="shell"><div class="section-heading" data-reveal><p class="eyebrow">HOW IT WORKS</p><h2>Three steps keep the real details out</h2></div><ol class="steps-grid">{steps.map(([no, title, description]) => <li class="step" data-reveal><div class="step-head"><span class="step-no">{no}</span><span class="step-line"></span></div><h3>{title}</h3><p>{description}</p></li>)}</ol></div></section>
  <section class="section" id="privacy"><div class="shell ledger-grid"><div class="section-heading" data-reveal><p class="eyebrow">PRIVACY LEDGER</p><h2>How service data is used</h2><p>A privacy product starts by collecting less, not by promising to delete an oversized record later.</p></div><div data-reveal><ol class="ledger-list">{ledger.map((item, index) => <li><span class="no">{String(index + 1).padStart(2, '0')}</span><span class="value">{item}</span><span class="empty">∅</span></li>)}</ol><p class="ledger-note">Read the full <a href="/en/privacy/">privacy policy</a>.</p></div></div></section>
  <section class="section section-soft"><div class="shell"><div class="section-heading" data-reveal><p class="eyebrow">WHERE IT FITS</p><h2>Every form that asks for an email deserves a boundary</h2></div><div class="use-grid">{useCases.map(([title, description]) => <article class="use-card" data-reveal><h3>{title}</h3><p>{description}</p></article>)}</div></div></section>
  <section class="section" id="faq"><div class="shell faq-layout"><div class="section-heading" data-reveal><p class="eyebrow">FAQ</p><h2>About temp mail and anonymous aliases</h2></div><div class="faq-list" data-reveal>{faqs.map(([question, answer], index) => <details class="faq-item"><summary><span class="faq-index">{String(index + 1).padStart(2, '0')}</span><span class="faq-question">{question}</span><span class="faq-plus">+</span></summary><p class="faq-answer">{answer}</p></details>)}</div></div></section>
  <section class="cta-band"><div class="shell cta-inner" data-reveal><h2>Use a different address next time</h2><p>Open a disposable inbox in seconds, or create a controllable alias for the accounts you keep.</p><div class="cta-actions"><a class="btn btn-primary" href={site.appOrigin}>Start free</a><a class="btn btn-secondary" href="/en/identity/">Generate an identity</a></div></div></section>
</Layout>
