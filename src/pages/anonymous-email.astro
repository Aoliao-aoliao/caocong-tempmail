---
import ProductPage from '../layouts/ProductPage.astro';
---
<ProductPage
  pageTitle="匿名邮箱别名"
  eyebrow="长效匿名邮箱 · 邮箱别名"
  titleTop="匿名邮箱，"
  titleAccent="长期有效。"
  description="为网购、订阅和长期账号各创建一个独立别名，收到的邮件原样转发到常用邮箱，真实地址不会公开。"
  primary="免费创建长效别名"
  secondary="和临时邮箱有什么区别"
  note="免费版包含一个长效别名　·　无需手机号"
  variant="alias"
  metrics={[["长期", "有效期内不过期"], ["转发", "送到常用邮箱"], ["一站一个", "来源可查"], ["一键", "随时停用"]]}
  features={[
    { no: '01', title: '有效期内一直可用', description: '长期别名适合购物、订阅以及需要持续接收通知的账号，不会像临时邮箱一样自动失效。', points: ['长期接收通知', '统一在后台管理', '无需创建新的真实邮箱'] },
    { no: '02', title: '邮件转发到常用邮箱', description: '邮件正文、发件人和附件按原样转发，你仍然只需要查看平常使用的收件箱。', points: ['原始发件人可见', '附件一并转发', '转发状态可以追踪'] },
    { no: '03', title: '一站一个，互不牵连', description: '每个平台使用不同别名，哪个地址开始收到垃圾邮件，停用哪一个，不会影响其他账号。', points: ['泄露来源容易定位', '单个别名独立停用', '真实邮箱永不公开'] },
  ]}
  detailTitle="把每个网站关在自己的隔间里"
  detailText="独立别名将不同网站的邮件入口隔开。一个地址泄露或被营销列表滥用时，只需关闭对应入口，其他账户和真实收件箱都不会受到影响。"
  faq={[["别名会不会自动过期？", "长期别名在套餐有效期内持续可用，除非你主动暂停或删除。"], ["对方能看到真实邮箱吗？", "不能。发件方只会看到分配给该场景的别名地址。"], ["一个网站应该用几个别名？", "通常一个网站一个别名最容易管理，也最方便判断地址从哪里泄露。"]]}
/>

