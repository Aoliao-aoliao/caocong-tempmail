---
import { site } from '../../config/site';
import Layout from '../../layouts/Layout.astro';
const groups = [{ no: '01', title: 'Identity and privacy', intro: 'Email, test identity, network and verification layers.', services: [['NodeMail', 'Anonymous email and test identities', 'CURRENT'], ['Network layer', 'Regional network exits', 'PLANNED'], ['Number layer', 'Verification and notification numbers', 'PLANNED']] }, { no: '02', title: 'Reach and operations', intro: 'Contact validation, shared notifications and team workflows.', services: [['Contact check', 'Contact information validation', 'PLANNED'], ['Team inbox', 'Shared notification routing', 'PLANNED']] }, { no: '03', title: 'Tools and infrastructure', intro: 'Building blocks for development, testing and automation.', services: [['Developer API', 'Address, alias and inbox endpoints', 'PLANNED'], ['Compute', 'Scalable task execution', 'PLANNED']] }];
---
<Layout locale="en" title="Partners · NodeMail"><header class="partners-hero"><div class="shell" data-reveal><p class="eyebrow">PRODUCT ECOSYSTEM</p><h1>Each layer works alone,<br /><span>and together.</span></h1><p>A clear, extensible product foundation for temporary inboxes, address tools and privacy services.</p><div class="hero-actions"><a class="btn btn-primary" href={site.appPath}>Open NodeMail</a><a class="btn btn-secondary" href="/en/contact/">Discuss a partnership</a></div></div></header>{groups.map((group) => <section class="section partner-group"><div class="shell"><div class="partner-intro" data-reveal><span>{group.no}</span><div><h2>{group.title}</h2><p>{group.intro}</p></div></div><div class="partner-list">{group.services.map(([name, description, status]) => <article data-reveal><div><h3>{name}</h3><p>{description}</p></div><span class:list={{ current: status === 'CURRENT' }}>{status}</span></article>)}</div></div></section>)}<section class="cta-band"><div class="shell cta-inner" data-reveal><h2>Start with the email layer</h2><p>Each service remains independent so future integrations do not force shared accounts or data.</p><div class="cta-actions"><a class="btn btn-primary" href={site.appPath}>Try it free</a></div></div></section></Layout>
