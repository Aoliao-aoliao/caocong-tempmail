---
import InfoPage from '../layouts/InfoPage.astro';
const sections = [
  {title:'账户与安全信息',paragraphs:['注册需要账户邮箱和密码，密码以加盐摘要保存。登录会话会保存 IP、浏览器 User-Agent 和有效期；访客会话保存 IP 与 User-Agent 的哈希，用于安全校验和防滥用。哈希不是完全不记录。']},
  {title:'人机验证与基础设施',paragraphs:['人机验证使用 Cloudflare Turnstile。验证服务和网站基础设施可能处理连接信息；本站不作“零日志”或第三方完全不处理数据的承诺。']},
  {title:'收信与到期清理',paragraphs:['邮件及附件在邮箱有效期内用于网页收信。邮箱到期后由清理任务处理站内邮件与附件；中继上游的相关原件在满足关联保护条件后移入垃圾箱，不代表上游立即永久删除。召回恢复地址，不恢复已清理的旧信。']},
  {title:'密码找回',paragraphs:['启用后，平台通过配置的 SMTP 服务向账户邮箱发送短期验证码。验证码不以明文保存；重置成功会撤销该账户的原有登录会话。邮件服务商会处理投递所需的地址与邮件内容。']},
  {title:'范围与联系',paragraphs:['本说明不承诺基础设施、上游邮件服务或既有备份中的全部副本同步消失。如需了解账户数据或提出删除请求，请联系网站支持；具体处理需核实身份及实际保留范围。']},
];
---
<InfoPage title="隐私政策" eyebrow="数据使用说明" intro="说明当前账户、会话、收信与安全验证所需的数据处理。" updated="2026 年 10 月" sections={sections}/>
