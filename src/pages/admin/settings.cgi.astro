---
import AdminLayout from '../../layouts/AdminLayout.astro'; import AdminConsole from '../../components/AdminConsole'; import { getAdminData } from '../../../server/admin/read-model.mjs'; const data = await getAdminData();
import {getSessionUser,sessionCookieName} from '../../../server/auth/service.mjs';
const viewer=await getSessionUser(Astro.cookies.get(sessionCookieName)?.value);
---
<AdminLayout title="系统配置 | NodeMail 管理后台" active="settings"><AdminConsole view="settings" data={data} canConfigureMail={viewer?.role==='SUPER_ADMIN'} client:load /></AdminLayout>
