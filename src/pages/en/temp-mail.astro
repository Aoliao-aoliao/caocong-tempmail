<ProductPage locale="en" pageTitle="Disposable temp mail" eyebrow="DISPOSABLE TEMP MAIL" titleTop="A temporary inbox," titleAccent="gone on schedule." description="Open a working inbox for a verification code, confirmation or download without creating an account or providing a phone number." primary="Get a free temp inbox" secondary="Compare lasting aliases" note="No sign-up · No phone number · Instant access" variant="temp" metrics={[["NO SIGN-UP", "Open instantly"], ["7 DAYS", "Default lifetime"], ["FAST", "Inbox refresh"], ["EXPIRY", "Whole inbox removed"]]} features={[{ no: '01', title: 'Open it and start receiving', description: 'A random inbox is available as soon as the app loads.', points: ['No registration flow', 'No phone number', 'Replace the address in one click'] }, { no: '02', title: 'Independent addresses', description: 'Every temporary address has its own inbox and visible expiry.', points: ['Separate message lists', 'Clear status and lifetime', 'Useful for development tests'] }, { no: '03', title: 'Nothing survives expiry', description: 'The inbox, messages and attachments share one destruction window.', points: ['No expired recovery', 'No lasting account clutter', 'Visible countdown'] }]} detailTitle="Receive what you need, then leave no route behind" detailText="Temporary mail is designed for a short exchange. The address and its messages share one lifetime, so a one-off sign-up does not become a permanent source of marketing." faq={[["How long does it last?", "The default window is seven days and the app shows the remaining time."], ["Can it receive attachments?", "The interface includes a safe reading view; attachment handling is enabled when the mail backend is connected."], ["Can expired mail be recovered?", "No. Automatic destruction is the core promise, so save anything you genuinely need before expiry."]]} />
