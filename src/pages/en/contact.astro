---
import Layout from '../../layouts/Layout.astro';
import { site } from '../../config/site';
---
<Layout locale="en" title={`Contact · ${site.name}`}><header class="directory-hero"><div class="shell" data-reveal><p class="eyebrow">CONTACT</p><h1>Send the question to the right place</h1><p>Product support, technical integration, privacy requests and partnerships all begin here.</p></div></header><section class="section"><div class="shell contact-grid"><div class="contact-details" data-reveal><p class="eyebrow">DIRECT CONTACT</p><h2>We usually reply within two business days</h2><a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a><dl><div><dt>Product support</dt><dd>Accounts, aliases, mail and domain setup</dd></div><div><dt>Security and privacy</dt><dd>Data requests, vulnerability and abuse reports</dd></div><div><dt>Partnerships</dt><dd>Integrations and commercial proposals</dd></div></dl></div><form class="contact-form plate" data-contact-form data-reveal><label>Your email<input name="email" type="email" autocomplete="email" required placeholder="you@example.com" /></label><label>Topic<select name="topic"><option>Product support</option><option>Privacy and security</option><option>Partnership</option><option>Other</option></select></label><label>Message<textarea name="message" required rows="6" placeholder="Describe what you need"></textarea></label><button class="btn btn-primary" type="submit">Prepare email</button><output hidden>Your mail app has opened. Review the message before sending.</output></form></div></section></Layout>
<script is:inline define:vars={{ contactEmail: site.contactEmail }}>document.querySelector('[data-contact-form]')?.addEventListener('submit', function (event) { event.preventDefault(); const data = new FormData(this); const subject = String(data.get('topic') || 'Website enquiry'); const body = `${String(data.get('message') || '')}\n\nReply to: ${String(data.get('email') || '')}`; window.location.href = `mailto:${contactEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`; const output = this.querySelector('output'); if (output) output.hidden = false; });</script>
