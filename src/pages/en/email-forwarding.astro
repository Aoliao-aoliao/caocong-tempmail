<ProductPage locale="en" pageTitle="Email forwarding" eyebrow="EMAIL FORWARDING · ALIAS RELAY" titleTop="Private on the outside," titleAccent="familiar on the inside." description="Mail sent to an alias is relayed to the mailbox you already check. No new app, password or second inbox routine." primary="Set up forwarding" secondary="See how aliases work" note="One target on the free plan · Switch off anytime" variant="forward" metrics={[["UNTOUCHED", "Message content"], ["FAST", "Delivery path"], ["NO EXTRA", "Inbox to monitor"], ["NO COPY", "After delivery"]]} features={[{ no: '01', title: 'Keep your current routine', description: 'Continue using the mailbox and client you already know.', points: ['No new app to install', 'No extra password', 'All notices in one place'] }, { no: '02', title: 'Preserve sender and content', description: 'The interface is designed to retain sender details, body and attachments.', points: ['Receiving alias remains visible', 'No inserted advertising', 'Attachments stay attached'] }, { no: '03', title: 'Do not retain another body copy', description: 'The production relay should process mail only for delivery.', points: ['No body after successful delivery', 'No content analysis', 'No advertising profile'] }]} detailTitle="Your mailbox does not need to change" detailText="Forwarding protects the public address without creating a second place to check. The control layer lives in the alias dashboard, while reading stays in your usual inbox." faq={[["Is forwarded mail stored?", "The intended backend processes it for delivery and does not retain an extra body copy afterward."], ["Can I turn forwarding off?", "Yes, per alias, without affecting any other address."], ["Which mailbox providers work?", "Any standard inbox that can receive mail can be used as a target."]]} />
