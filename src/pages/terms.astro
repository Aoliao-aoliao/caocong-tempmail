const sections = [
  { title: '服务范围', paragraphs: ['NodeMail 提供临时收件箱、自定义域名、开发接口和测试身份生成等能力。实际额度与可用功能以应用控制台和运营配置为准。'] },
  { title: '可接受的使用方式', paragraphs: ['服务用于隐私保护、测试和正常通信。禁止欺诈、骚扰、垃圾邮件、冒充他人、规避法律责任或其他违法用途。随机身份只能用于测试与占位。'] },
  { title: '账户与终止', paragraphs: ['违反条款的账户可能被限制或终止。用户也应能随时删除自己的账户和相关别名。'] },
