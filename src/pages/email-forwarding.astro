---
import ProductPage from '../layouts/ProductPage.astro';
---
<ProductPage
  pageTitle="邮件转发"
  eyebrow="邮件转发 · 别名转发"
  titleTop="邮件转发，"
  titleAccent="收件箱照旧。"
  description="别名收到的邮件会原样转发到你每天使用的邮箱。你不必多开一个收件箱，也不需要改变已有的查收习惯。"
  primary="设置邮件转发"
  secondary="别名怎么创建"
  note="免费版可转发到一个邮箱　·　随时关闭"
  variant="forward"
  metrics={[["原样", "不改正文"], ["秒级", "转发到达"], ["不留", "正文副本"], ["多目标", "一封同时送达"]]}
  features={[
    { no: '01', title: '收信习惯完全不用改', description: '邮件仍然出现在你熟悉的收件箱中，不需要登录额外后台才能阅读日常通知。', points: ['继续使用原邮箱', '无需安装客户端', '转发状态统一查看'] },
    { no: '02', title: '正文与附件原样送达', description: '发件人、主题、正文和附件保持完整，验证码与通知可以直接在目标邮箱处理。', points: ['保留原始内容', '附件正常传递', '失败自动重试'] },
    { no: '03', title: '转发链路不保留正文', description: '邮件只在投递过程中短暂处理，成功送达后不建立可长期检索的正文副本。', points: ['减少敏感数据留存', '记录状态而非内容', '随时更换转发目标'] },
  ]}
  detailTitle="邮件经过，但不会住下来"
  detailText="转发系统只负责接收、检查和投递。投递队列保存必要的状态与重试信息，邮件正文不会被当作长期内容库保存。"
  faq={[["转发会修改邮件内容吗？", "不会，正文与附件保持原样，只增加必要的投递头信息。"], ["转发失败怎么办？", "系统会按规则重试，并在用户后台显示失败状态。"], ["可以转发到多个邮箱吗？", "前端已包含多目标结构，具体数量可由套餐配置。"]]}
/>

