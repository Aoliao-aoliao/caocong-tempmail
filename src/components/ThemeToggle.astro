---
// 明暗主题切换按钮，默认浅色，记住用户选择（localStorage）
---

<button
  id="theme-toggle"
  type="button"
  aria-label="切换明暗模式"
  class="theme-toggle"
>
  <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
  </svg>
  <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="hidden">
    <path d="M21 12.8A9 9 0 1111.2 3 7 7 0 0021 12.8z" />
  </svg>
</button>

<script is:inline>
  (function () {
    var btn = document.getElementById('theme-toggle');
    var sun = document.getElementById('icon-sun');
    var moon = document.getElementById('icon-moon');

    function sync() {
      var isDark = document.documentElement.dataset.theme === 'dark';
      sun.classList.toggle('hidden', !isDark);
      moon.classList.toggle('hidden', isDark);
    }

    sync();

    btn?.addEventListener('click', function () {
      var next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('maskmail_theme', next);
      } catch (e) {}
      sync();
    });
  })();
</script>
