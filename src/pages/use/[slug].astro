---
import ArticlePage from '../../layouts/ArticlePage.astro';
import { useEntries } from '../../content/library';
const entry = useEntries.find((item) => item.slug === Astro.params.slug);
if (!entry) return new Response('页面不存在。', { status: 404 });
---
<ArticlePage entry={entry} sectionLabel="使用场景" />
