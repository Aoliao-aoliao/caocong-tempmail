# Reference only. Run manage.mjs configure to generate unique credentials.
NODEMAIL_IMAGE=registry.example.invalid/nodemail:VERSION
NODEMAIL_SITE_ORIGIN=https://mail.example.com
NODEMAIL_PUBLIC_ORIGIN=https://mail.example.com
NODEMAIL_CONTACT_EMAIL=admin@example.com
NODEMAIL_GMPAY_ORIGIN=
SMTP_NAME=mx.example.com
# Credentials and the unique COMPOSE_PROJECT_NAME are generated by configure.
HTTP_BIND=127.0.0.1
HTTP_PORT=4321
SMTP_BIND=0.0.0.0
SMTP_PORT=25
SMTP_TLS_KEY_FILE=
SMTP_TLS_CERT_FILE=
