---
import ArticlePage from '../../layouts/ArticlePage.astro';
import { alternativeEntries } from '../../content/library';
const entry = alternativeEntries.find((item) => item.slug === Astro.params.slug);
if (!entry) return new Response('页面不存在。', { status: 404 });
---
<ArticlePage entry={entry} sectionLabel="比较维度" />
