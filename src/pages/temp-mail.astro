---
import ProductPage from '../layouts/ProductPage.astro';
---
<ProductPage
  pageTitle="临时邮箱"
  eyebrow="临时邮箱 · 一次性匿名邮箱"
  titleTop="临时邮箱，"
  titleAccent="7 天后自毁。"
  description="打开就有一个能收验证码的一次性邮箱，无需注册，也不要求手机号。到期后收件箱与其中邮件一起销毁。"
  primary="免费领一个临时邮箱"
  secondary="和长期别名有什么区别"
  note="免注册　·　不要求手机号　·　打开即用"
  variant="temp"
  metrics={[["免注册", "打开即用"], ["7 天", "有效期"], ["秒级", "验证码到达"], ["到期", "整箱销毁"]]}
  features={[
    { no: '01', title: '打开即用，不留账号', description: '页面打开后即可生成随机收件箱，适合只需要一次确认邮件或验证码的场景。', points: ['无需注册登录', '不要求手机号', '换一个地址只需一次点击'] },
    { no: '02', title: '批量生成，地址互相独立', description: '需要多个测试地址时，可以一次生成一组，每个地址有自己的收件箱和剩余时间。', points: ['每个地址独立收信', '状态与有效期清楚可见', '方便开发和批量测试'] },
    { no: '03', title: '到期即焚，不留副本', description: '有效期结束后整箱销毁，过期邮件不会进入长期账户，也不会继续占用存储空间。', points: ['邮件与附件一并删除', '不提供过期恢复', '剩余时间实时显示'] },
  ]}
  detailTitle="收完这一封，就可以忘掉它"
  detailText="临时邮箱为短期收信而设计。地址、邮件和附件都绑定同一个有效期，倒计时结束后整组数据清除，避免一次注册演变成长期垃圾邮件入口。"
  faq={[["临时邮箱能使用多久？", "默认有效期为 7 天，应用中会清楚显示剩余时间。"], ["可以收到附件吗？", "前端已预留附件列表和隔离阅读界面，接入邮件后端后可按套餐开放。"], ["过期后还能找回邮件吗？", "不能。到期销毁是临时邮箱的核心规则，请提前保存确实需要保留的内容。"]]}
/>

