---
import Layout from '../layouts/Layout.astro';
import IdentityCard from '../components/IdentityCard';
import { createIdentity } from '../lib/random';
import { site } from '../config/site';

const heroIdentity = createIdentity('en');

const products = [
  {
    mark: 'A',
    code: 'RELAY INBOX',
    title: '主流邮箱中继收信',
    href: `${site.appOrigin}/tools/real_mail.cgi`,
    description: '通过可用的中继账号生成收信地址，在 NodeMail 收件箱查看邮件。地址有效期和可用后缀以申请页面为准。',
    points: ['独立收信地址', '网页集中查看邮件', '按所选有效期使用'],
  },
  {
    mark: 'B',
    code: 'DISPOSABLE INBOX',
    title: '一次性临时邮箱',
    href: '/temp-mail/',
    description: '打开页面立即获取收件箱，用来接收验证码、确认邮件和下载链接；到期后整个邮箱自动销毁。',
    points: ['无需注册，立即使用', '新邮件快速显示', '到期后清理站内邮件'],
  },
  {
    mark: 'C',
    code: 'IDENTITY GENERATOR',
    title: '随机地址身份',
    href: '/identity/',
    description: '姓名、街道、城市、邮编和电话按照当地格式生成，用于开发、测试和不需要真实身份的占位表单。',
    points: ['美国格式的测试资料', '覆盖美国 50 州与华盛顿特区', '整套资料一键复制'],
  },
];

const steps = [
  ['01', '签发', '一键创建别名或临时收件箱，需要填表时再生成一套随机身份。'],
  ['02', '使用', '照常注册和收信，对方只会看到当前使用的隔离身份。'],
  ['03', '焚毁', '收件箱到期销毁，邮箱的暂停、召回和清理由各自状态与有效期决定。'],
];

const ledger = [
  '为会话安全和限流处理 IP 与浏览器信息',
  '邮箱到期后清理网站邮件与附件',
  '注册无需手机号和身份资料',
  '人机验证使用第三方验证服务',
  '邮件按收信、展示和清理需要处理',
];

const useCases = [
  ['注册与试用', '试用新服务时，不必交出真实邮箱。'],
  ['下载与订阅', '获取资料时，使用一个到期销毁的地址。'],
  ['开发与测试', '生成成套测试账号和格式正确的占位资料。'],
  ['论坛与社区', '让公开发言和日常身份保持互不关联。'],
  ['垃圾邮件隔离', '营销邮件进入专用别名，常用邮箱保持清爽。'],
  ['数据泄露止损', '发现地址泄露后，只停用对应别名。'],
];

const faqs = [
  ['临时邮箱与匿名邮箱别名有什么区别？', '临时邮箱适合一次性验证码和短期注册，到期自动销毁；中继邮箱通过平台配置的上游账号收信，在本站查看，按所选有效期使用。'],
  ['平台的几个功能分别解决什么问题？', '临时邮箱和中继邮箱提供不同后缀的网页收信；私有域名需按规则申请和审核。'],
  ['生成的姓名和地址是真实的吗？', '不是。信息按照各地格式规则随机生成，只用于开发、测试和占位，不对应任何真实家庭。'],
  ['匿名邮箱是否合法？', '保护个人联系方式是正常的隐私措施，但不得用于欺诈、骚扰或其他违法行为。'],
  ['需要注册账号吗？', '临时邮箱与身份生成器无需注册；登录后可管理自己申请的邮箱。'],
  ['临时邮箱还是长期别名，该怎么选？', '短期收信可选择临时邮箱；需要持续收信时，在申请页选择合适的有效时长，并留意到期时间。'],
];
---

<Layout>
  <section class="home-hero">
    <div class="shell home-hero-grid">
      <div class="hero-content">
        <p class="eyebrow">匿名邮箱 · 一次性邮箱 · 随机身份</p>
        <h1 class="display-title">真实身份，<br /><span class="accent">只留给自己。</span></h1>
        <p class="hero-copy">每一次注册、订阅和验证，都用独立别名与临时邮箱应对；再配上一套格式正确的随机身份，让真实邮箱和地址始终留在自己的保险库中。</p>
        <ul class="hero-promises">
          <li><strong>免注册</strong><span>临时邮箱打开即用</span></li>
          <li><strong>安全控制</strong><span>会话验证与请求限流</span></li>
          <li><strong>即焚</strong><span>到期整箱销毁</span></li>
        </ul>
        <div class="hero-actions">
          <a class="btn btn-primary" href={site.appOrigin}>领取一个匿名邮箱</a>
          <a class="btn btn-secondary" href="#how">看看它如何工作</a>
        </div>
      </div>
      <div class="hero-card-wrap">
        <IdentityCard initialIdentity={heroIdentity} client:load />
        <p class="hero-card-note">一个场景一套身份，彼此不关联。真实姓名、住址和手机号从不外泄。</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-heading" data-reveal>
        <p class="eyebrow">三件套</p>
        <h2>一套完整的身份隔离工具</h2>
        <p>临时收件箱、中继收信和美国格式测试资料，可按实际需求选择。</p>
      </div>
      <div class="product-grid">
        {products.map((product) => (
          <article class="product-card plate" data-reveal>
            <div class="product-card-top"><span class="product-mark">{product.mark}</span><span class="product-code">{product.code}</span></div>
            <h3><a href={product.href}>{product.title}</a></h3>
            <p>{product.description}</p>
            <ul class="product-points">{product.points.map((point) => <li>{point}</li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-soft" id="how">
    <div class="shell">
      <div class="section-heading" data-reveal><p class="eyebrow">工作原理</p><h2>三步，把真实身份留在库里</h2></div>
      <ol class="steps-grid">
        {steps.map(([no, title, description]) => (
          <li class="step" data-reveal>
            <div class="step-head"><span class="step-no">{no}</span><span class="step-line"></span></div>
            <h3>{title}</h3><p>{description}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" id="privacy">
    <div class="shell ledger-grid">
      <div class="section-heading" data-reveal>
        <p class="eyebrow">隐私承诺</p><h2>数据使用说明</h2>
        <p>账户、会话和收信需要处理必要数据，具体用途与清理范围见隐私政策。</p>
      </div>
      <div data-reveal>
        <ol class="ledger-list">
          {ledger.map((item, index) => <li><span class="no">{String(index + 1).padStart(2, '0')}</span><span class="value">{item}</span><span class="empty">∅</span></li>)}
        </ol>
        <p class="ledger-note">完整说明请查看 <a href="/privacy/">隐私政策</a>。</p>
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="shell">
      <div class="section-heading" data-reveal><p class="eyebrow">适用场景</p><h2>留邮箱之前，先戴上面具</h2></div>
      <div class="use-grid">{useCases.map(([title, description]) => <article class="use-card" data-reveal><h3>{title}</h3><p>{description}</p></article>)}</div>
    </div>
  </section>

  <section class="section" id="faq">
    <div class="shell faq-layout">
      <div class="section-heading" data-reveal><p class="eyebrow">FAQ</p><h2>关于临时邮箱与匿名邮箱</h2></div>
      <div class="faq-list" data-reveal>
        {faqs.map(([question, answer], index) => (
          <details class="faq-item">
            <summary><span class="faq-index">{String(index + 1).padStart(2, '0')}</span><span class="faq-question">{question}</span><span class="faq-plus">+</span></summary>
            <p class="faq-answer">{answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="shell cta-inner" data-reveal>
      <h2>下一次注册，换一副面具</h2>
      <p>免费领取你的第一个匿名邮箱，或先打开一个到期销毁的临时收件箱。</p>
      <div class="cta-actions"><a class="btn btn-primary" href={site.appOrigin}>免费开始使用</a><a class="btn btn-secondary" href="/identity/">生成随机身份</a></div>
    </div>
  </section>
</Layout>
