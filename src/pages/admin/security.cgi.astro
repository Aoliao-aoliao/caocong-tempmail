---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminConsole from '../../components/AdminConsole';
import { getAdminData } from '../../../server/admin/read-model.mjs';
import { getSessionUser, sessionCookieName } from '../../../server/auth/service.mjs';

const data = await getAdminData();
const isLocalPreview = import.meta.env.DEV && (Astro.url.hostname === '127.0.0.1' || Astro.url.hostname === 'localhost');
const sessionUser = isLocalPreview
  ? { role:'SUPER_ADMIN' }
  : await getSessionUser(Astro.cookies.get(sessionCookieName)?.value);
data.security.turnstileCanManage = sessionUser?.role === 'SUPER_ADMIN';
---
<AdminLayout title="人机验证 | NodeMail 管理后台" active="security">
  <AdminConsole view="security" data={data} client:load />
</AdminLayout>
